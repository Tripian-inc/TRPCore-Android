<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashed-border variant of trp_bg_order_time_container. Used for Flexible activities
  so the order-time container reads the same as a normal time pill, only with a
  dashed outline to convey "not a real time slot".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/trp_lineWeak"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="16dp" />
</shape>
