<?xml version="1.0" encoding="utf-8"?>
<!--
  Outer dashed-border card background for the Flexible-Activity cell. 16dp corner
  radius, 1dp dashed stroke. Distinguishes the card from regular (solid-border)
  booked / reserved activity cells.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/trp_text_secondary"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="16dp" />
</shape>
