<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashed-border order chip used by the Flexible-Activity time badge in place of a
  numeric order. 20dp diameter, 1.5dp stroke, 4dp dash / 3dp gap. The text inside is
  the U+2212 MINUS SIGN ("−"), not an ASCII hyphen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/trp_text_secondary"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
