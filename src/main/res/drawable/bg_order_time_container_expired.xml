<?xml version="1.0" encoding="utf-8"?>
<!--
  Time-badge container background for the "availability expired" state (Theme 17).
  Pale-red fill with red border — distinguishes from the orange conflict state.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/trp_expired_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/trp_expired_border" />
    <corners android:radius="6dp" />
</shape>
