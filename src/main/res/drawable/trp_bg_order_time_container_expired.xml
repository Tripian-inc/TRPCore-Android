<?xml version="1.0" encoding="utf-8"?>
<!--
  Time-badge container background for the availability-expired state. Mirrors the
  conflict (time-overlap) drawable's shape exactly (rectangle, 1dp stroke, 16dp
  corner radius) — only the colors differ: pale-red fill + red border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/trp_expired_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/trp_expired_fg" />
    <corners android:radius="16dp" />
</shape>
