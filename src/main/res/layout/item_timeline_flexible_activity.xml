<?xml version="1.0" encoding="utf-8"?>
<!--
  Flexible-time activity cell. Mirrors the reserved-activity cell layout but the
  order/time header is replaced by FlexibleTimeBadgeView (dashed circle with the
  U+2212 minus + "Flexible entry / Check the timetable" labels), and the duration
  row is omitted (a flexible activity has additionalData.duration == -1).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:layout_marginTop="16dp"
    android:paddingHorizontal="16dp">

    <!-- Flexible time badge in place of order/time row -->
    <com.tripian.trpcore.ui.timeline.views.FlexibleTimeBadgeView
        android:id="@+id/flexibleTimeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Spacer between badge and content -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Content Row (Image + Details) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Activity Image"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row with delete button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/semibold"
                    android:maxLines="2"
                    android:textColor="@color/trp_text_primary"
                    android:textSize="16sp"
                    tools:text="Hop-on Hop-off Sightseeing Bus" />

                <ImageButton
                    android:id="@+id/btnChangeTime"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Change Time"
                    android:src="@drawable/trp_ic_change_time" />

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Remove"
                    android:src="@drawable/trp_ic_remove_step" />

            </LinearLayout>

            <!-- Rating row (hidden when no rating) -->
            <LinearLayout
                android:id="@+id/llRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/trp_text_primary"
                    android:textSize="14sp"
                    tools:text="4.5" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Rating"
                    android:src="@drawable/trp_ic_rating_star" />

                <TextView
                    android:id="@+id/tvReviewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/medium"
                    android:textColor="@color/trp_fgWeak"
                    android:textSize="14sp"
                    tools:text="1,234 opinions" />

            </LinearLayout>

            <!-- No-Location badge (Theme 6) -->
            <include
                android:id="@+id/noLocationBadge"
                layout="@layout/include_no_location_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Cancellation (advantage colour) -->
            <TextView
                android:id="@+id/tvCancellation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/medium"
                android:textColor="@color/trp_advantage"
                android:textSize="14sp"
                tools:text="Free cancellation" />

            <!-- Reservation CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReservation"
                style="@style/TrpButtonPrimary"
                android:layout_height="@dimen/_31sdp"
                android:layout_marginTop="@dimen/_8sdp"
                tools:text="Reservation" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
