<?xml version="1.0" encoding="utf-8"?>
<!--
  Flexible-time activity cell. Mirrors the reserved-activity cell layout, but the
  order-time container uses a dashed border and its text track shows
  "Flexible entry / Check the timetable" in place of a time range. The duration
  row is omitted (a flexible activity has additionalData.duration == -1).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingHorizontal="16dp">

    <!-- Order-Time Container — same structure as the reserved-activity cell, just
         with a dashed border and Flexible entry / Check the timetable text in place
         of the time range. -->
    <LinearLayout
        android:id="@+id/orderTimeContainer"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/trp_bg_order_time_container_flexible"
        android:gravity="center_vertical"
        android:paddingEnd="10dp"
        android:orientation="horizontal">

        <!-- Order Badge with U+2212 minus character -->
        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/trp_bg_step_order_new"
            android:fontFamily="@font/semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−"
            android:textColor="@color/trp_white"
            android:textSize="16sp" />

        <!-- "Flexible entry" — bold, replaces the time range -->
        <TextView
            android:id="@+id/tvFlexibleTitle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/semibold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/trp_text_primary"
            android:textSize="14sp"
            tools:text="Flexible entry" />

        <!-- "Check the timetable" — medium 11sp, primary-text colour (#333333). -->
        <TextView
            android:id="@+id/tvFlexibleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/trp_text_primary"
            android:textSize="11sp"
            tools:text="Check the timetable" />

    </LinearLayout>

    <!-- Vertical Line (matches reserved-activity layout) -->
    <View
        android:id="@+id/verticalLine"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:background="@color/trp_lineWeak" />

    <!-- Content Row (Image + Details) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Activity Image"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row with delete button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/semibold"
                    android:maxLines="2"
                    android:textColor="@color/trp_text_primary"
                    android:textSize="16sp"
                    tools:text="Hop-on Hop-off Sightseeing Bus" />

                <ImageButton
                    android:id="@+id/btnChangeTime"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Change Time"
                    android:src="@drawable/trp_ic_change_time" />

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Remove"
                    android:src="@drawable/trp_ic_remove_step" />

            </LinearLayout>

            <!-- Rating row (hidden when no rating) -->
            <LinearLayout
                android:id="@+id/llRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/trp_text_primary"
                    android:textSize="14sp"
                    tools:text="4.5" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Rating"
                    android:src="@drawable/trp_ic_rating_star" />

                <TextView
                    android:id="@+id/tvReviewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/medium"
                    android:textColor="@color/trp_fgWeak"
                    android:textSize="14sp"
                    tools:text="1,234 opinions" />

            </LinearLayout>

            <!-- Badge row: activity chip + "no exact location" chip side-by-side.
                 Activity chip is always shown for FlexibleActivity cells; the
                 no-location chip is toggled by the VH based on segment data. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActivityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/trp_bg_category_badge"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/trp_grayFg"
                    android:textSize="12sp"
                    tools:text="Activity" />

                <include
                    android:id="@+id/noLocationBadge"
                    layout="@layout/include_no_location_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- Cancellation (advantage colour) -->
            <TextView
                android:id="@+id/tvCancellation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/medium"
                android:textColor="@color/trp_advantage"
                android:textSize="14sp"
                tools:text="Free cancellation" />

            <!-- Reservation CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReservation"
                style="@style/TrpButtonPrimary"
                android:layout_height="@dimen/_31sdp"
                android:layout_marginTop="@dimen/_8sdp"
                tools:text="Reservation" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
