<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trp_white">

    <!-- Navigation Area -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/trp_ic_back_timeline"
        android:padding="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />


    <com.tripian.trpcore.util.widget.SearchBarView
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:trpSearchBackground="@drawable/trp_bg_search_bar"
        app:trpSearchHintColor="@color/trp_fgWeak"
        app:trpSearchHorizontalPadding="12dp"
        app:trpSearchIcon="@drawable/trp_ic_search_gray"
        app:trpSearchIconSize="20dp"
        app:trpSearchIconTint="@color/trp_fgWeak" />

    <!-- Default Content View -->
    <LinearLayout
        android:id="@+id/defaultContentView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp">

        <!-- Near Me Option -->
        <LinearLayout
            android:id="@+id/nearMeOption"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/trp_ic_location"
                app:tint="@color/trp_text_primary" />

            <TextView
                android:id="@+id/tvNearMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                tools:text="Near Me"
                android:textSize="16sp"
                android:fontFamily="@font/medium"
                android:textColor="@color/trp_text_primary" />

        </LinearLayout>

        <!-- City Center Option -->
        <LinearLayout
            android:id="@+id/cityCenterOption"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/trp_ic_city_center"
                app:tint="@color/trp_text_primary" />

            <TextView
                android:id="@+id/tvCityCenterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:textSize="16sp"
                android:fontFamily="@font/medium"
                android:textColor="@color/trp_text_primary"
                tools:text="Barcelona | City Center" />

        </LinearLayout>

        <!-- Section Title -->
        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            tools:text="Saved Activities"
            android:textSize="16sp"
            android:fontFamily="@font/semibold"
            android:textColor="@color/trp_text_primary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Saved Activities List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedActivities"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            tools:visibility="visible"
            tools:listitem="@layout/item_saved_activity" />

    </LinearLayout>

    <!-- Search Results View (Hidden by default) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"
        tools:listitem="@layout/item_saved_activity" />

    <!-- Search Empty State -->
    <TextView
        android:id="@+id/tvSearchEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/trp_timeline_text_secondary"
        android:fontFamily="@font/medium"
        android:visibility="gone"
        tools:text="No destinations found"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
