<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trp_white"
    android:orientation="vertical">

    <!-- Fixed Header: Back Button + Title -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_10sdp">

        <com.tripian.trpcore.util.widget.ImageView
            android:id="@+id/imBack"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/trp_ic_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="vertical">

            <com.tripian.trpcore.util.widget.TextView
                android:id="@+id/tvTitle"
                style="@style/TrpTextHeader2"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="center"
                tools:text="Activities" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fixed: Search Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_8sdp">

        <com.tripian.trpcore.util.widget.SearchBarView
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <ProgressBar
            android:id="@+id/pbSearchProgress"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_48sdp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Collapsible region: filter+sort, categories, result count scroll off
         when the activities list is scrolled. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/trp_white"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <!-- Scrollable: Filter & Sort Buttons Row -->
            <LinearLayout
                android:id="@+id/llFilterSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:orientation="horizontal"
                app:layout_scrollFlags="scroll|enterAlways">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilters"
                    style="@style/TrpButtonOutlinedFilter"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:icon="@drawable/trp_ic_filter_activity"
                    app:iconTint="@null"
                    tools:text="Filters" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSortBy"
                    style="@style/TrpButtonOutlinedFilter"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:icon="@drawable/trp_ic_order_activity"
                    app:iconTint="@color/trp_text_primary"
                    tools:text="Sort by" />
            </LinearLayout>

            <!-- Scrollable: Category Filter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_68sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_scrollFlags="scroll|enterAlways" />

            <!-- Scrollable: Result Count -->
            <com.tripian.trpcore.util.widget.TextView
                android:id="@+id/tvResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:fontFamily="@font/regular"
                android:textColor="@color/trp_activity_count_label"
                android:textSize="12sp"
                app:layout_scrollFlags="scroll|enterAlways"
                tools:text="150 activities found" />

            <!-- Shimmer placeholder for the result count, shown while the list
                 reloads (filter/sort/category/search) in place of tvResultCount. -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:visibility="gone"
                app:layout_scrollFlags="scroll|enterAlways"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="1.0"
                app:shimmer_highlight_alpha="1.0"
                app:shimmer_base_color="#E5E7EB"
                app:shimmer_highlight_color="#F5F6F8"
                app:shimmer_duration="1100">

                <View
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="12dp"
                    android:background="@drawable/trp_bg_skeleton_placeholder" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActivities"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/_16sdp" />

            <!-- Shimmering skeleton shown during the first load. Overlays the
                 RecyclerView and is hidden as soon as the first batch arrives. -->
            <include
                android:id="@+id/skeletonList"
                layout="@layout/view_activity_skeleton_list" />

            <com.tripian.trpcore.util.widget.TextView
                android:id="@+id/tvEmpty"
                style="@style/TrpTextBody1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/_24sdp"
                android:textColor="@color/trp_grey_30"
                android:visibility="gone"
                tools:text="No activities found" />

            <com.tripian.trpcore.util.widget.TextView
                android:id="@+id/tvError"
                style="@style/TrpTextBody1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/_24sdp"
                android:textColor="@color/trp_error"
                android:visibility="gone"
                tools:text="An error occurred" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>
