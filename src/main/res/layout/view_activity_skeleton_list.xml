<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmering skeleton list shown while activities load for the first time -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerActivitySkeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trp_white"
    android:visibility="gone"
    app:shimmer_auto_start="false"
    app:shimmer_base_alpha="1.0"
    app:shimmer_highlight_alpha="1.0"
    app:shimmer_base_color="#E5E7EB"
    app:shimmer_highlight_color="#F5F6F8"
    app:shimmer_duration="1100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/item_activity_card_skeleton" />
        <include layout="@layout/item_activity_card_skeleton" />
        <include layout="@layout/item_activity_card_skeleton" />
        <include layout="@layout/item_activity_card_skeleton" />
        <include layout="@layout/item_activity_card_skeleton" />
        <include layout="@layout/item_activity_card_skeleton" />

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
