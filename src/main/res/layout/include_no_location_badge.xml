<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable "No exact location" badge for timeline cells -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNoLocationBadge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/trp_bg_no_location_badge"
    android:gravity="center"
    android:orientation="horizontal"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvNoLocationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:includeFontPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:textColor="@color/trp_no_location_fg"
        android:textSize="12sp"
        tools:text="No exact location" />
</LinearLayout>
