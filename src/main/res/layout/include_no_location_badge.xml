<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable "No exact location" badge for timeline cells.
  Include with: <include android:id="@+id/noLocationBadge" layout="@layout/include_no_location_badge"/>
  Default visibility is GONE — VH bind sets it visible when item.isNoLocation == true.

  Sizing matches the category / activity chips (Montserrat Medium 12sp,
  8dp horiz + 6dp vert padding) so badges line up visually in the same row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNoLocationBadge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/trp_bg_no_location_badge"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvNoLocationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:includeFontPadding="false"
        android:textColor="@color/trp_no_location_fg"
        android:textSize="12sp"
        tools:text="No exact location" />
</LinearLayout>
