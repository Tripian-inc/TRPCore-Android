<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout"
    tools:layout_width="wrap_content"
    tools:layout_height="wrap_content">

    <!-- Dashed-circle order chip with U+2212 minus character -->
    <TextView
        android:id="@+id/tvOrderChip"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/trp_bg_flexible_order_chip"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="−"
        android:textColor="@color/trp_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFlexibleTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/trp_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvOrderChip"
        app:layout_constraintTop_toTopOf="@id/tvOrderChip"
        tools:text="Flexible entry" />

    <TextView
        android:id="@+id/tvFlexibleSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/trp_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/tvFlexibleTitle"
        app:layout_constraintStart_toStartOf="@id/tvFlexibleTitle"
        app:layout_constraintTop_toBottomOf="@id/tvFlexibleTitle"
        tools:text="Check the timetable" />

</merge>
