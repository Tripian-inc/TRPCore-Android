<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cellRoot"
    android:layout_width="match_parent"
    android:layout_height="44dp">

    <!-- Range band halves (same height as the day circle). The orange endpoint
         circles cap the band, so START shows only the right half and END only
         the left half — nothing spills past the endpoints. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/bandLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/bandRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="14sp"
        android:fontFamily="@font/medium"
        android:textColor="@color/trp_text_primary"
        tools:text="19" />

</FrameLayout>
