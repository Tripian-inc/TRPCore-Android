<?xml version="1.0" encoding="utf-8"?><!-- Activity Time Selection Bottom Sheet -->
<!-- iOS Reference: ActivityTimeSelectionView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/trp_bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_24sdp">

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/trp_bg_drag_handle" />

    <!-- Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:paddingHorizontal="@dimen/_16sdp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back"
            android:src="@drawable/trp_ic_back" />

        <!-- Title -->
        <com.tripian.trpcore.util.widget.TextView
            android:id="@+id/tvTitle"
            style="@style/TrpTextHeader2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            tools:text="Add Plan" />

    </RelativeLayout>

    <!-- Day Filter Section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Time Slot Section Label -->
    <com.tripian.trpcore.util.widget.TextView
        android:id="@+id/tvSelectTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:fontFamily="@font/semibold"
        android:textColor="@color/trp_text_primary"
        android:textSize="16sp"
        tools:text="Select Time" />

    <!-- Time Slots (Horizontal wrap layout using FlexboxLayout) -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexTimeSlots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true"
        app:alignItems="flex_start"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

    <!-- No Time Slots Message -->
    <com.tripian.trpcore.util.widget.TextView
        android:id="@+id/tvNoTimeSlots"
        style="@style/TrpTextBody2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="center"
        android:textColor="@color/trp_grey_30"
        android:visibility="gone"
        tools:text="No time slots available" />

    <!-- Flexible info card — shown when the selected day has only
         flexible (any-time) slots. Replaces the time grid. -->
    <LinearLayout
        android:id="@+id/flexibleInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/trp_bg_flexible_info_card"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp"
        tools:visibility="visible"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="Info"
            android:src="@drawable/trp_ic_information"
            app:tint="@color/trp_info_icon" />

        <com.tripian.trpcore.util.widget.TextView
            android:id="@+id/tvFlexibleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/trp_text_primary"
            android:textSize="14sp"
            tools:text="Valid at any time on the chosen day. Check the opening hours." />

    </LinearLayout>

    <!-- Plain "pin to top of itinerary" hint, shown directly under the
         flexible info card. Not part of the card itself. -->
    <com.tripian.trpcore.util.widget.TextView
        android:id="@+id/tvFlexibleTopOfItinerary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/montserrat_medium"
        android:textColor="@color/trp_fgWeak"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Add it to top of your itinerary." />

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        style="@style/TrpButtonPrimary"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:enabled="false"
        tools:text="Continue" />

</LinearLayout>
