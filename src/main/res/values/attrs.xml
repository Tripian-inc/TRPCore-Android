<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TrpCheckView">
        <attr name="trpText" format="reference" />
    </declare-styleable>

    <declare-styleable name="SearchBarView">
        <attr name="trpSearchBackground" format="reference"/>
        <attr name="trpSearchIcon" format="reference"/>
        <attr name="trpSearchIconTint" format="color"/>
        <attr name="trpSearchIconSize" format="dimension"/>
        <attr name="trpSearchHorizontalPadding" format="dimension"/>
        <attr name="trpSearchTextColor" format="color"/>
        <attr name="trpSearchHintColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="TrpPillInputView">
        <attr name="trpLabelText" format="string"/>
        <attr name="trpPlaceholderText" format="string"/>
        <attr name="trpIsPasswordToggleEnabled" format="boolean"/>
        <attr name="android:inputType"/> <!-- pass through -->
        <attr name="trpLabelTextAppearance" format="reference"/>
        <attr name="trpFieldTextAppearance" format="reference"/>
        <attr name="trpPlaceholderTextAppearance" format="reference"/>
    </declare-styleable>
</resources>
