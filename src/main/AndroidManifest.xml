<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tripian.trpcore">


    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>
    <application
        android:supportsRtl="true"
        android:theme="@style/TrpAppTheme">

        <activity
            android:name="com.tripian.trpcore.ui.common.ACWebPage"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.ACTimeline"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.poi.ACPOISelection"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.addplan.ACStartingPointSelection"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.activity.ACActivityListing"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.poilisting.ACPOIListing"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.savedplans.ACSavedPlans"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.tripian.trpcore.ui.timeline.poidetail.ACPOIDetail"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
